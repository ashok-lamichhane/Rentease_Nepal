# Backend environment variables
# Copy this file to .env for local development

MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rentease_nepal?retryWrites=true&w=majority
MONGO_DB_NAME=rentease_nepal
JWT_SECRET=your-secure-random-jwt-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Comma-separated list of allowed frontend URLs for CORS
# Example: https://rentease-nepal.vercel.app,http://localhost:3000
CLIENT_URL=http://localhost:3000

# Server port (Render/Railway set this automatically)
PORT=3001
